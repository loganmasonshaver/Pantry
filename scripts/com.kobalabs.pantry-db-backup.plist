<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly Supabase backup (scripts/backup-db.sh) while the project is on the Free plan.
     Install: cp to ~/Library/LaunchAgents, then launchctl bootout gui/$(id -u)/com.kobalabs.pantry-db-backup
     (if loaded) and launchctl bootstrap gui/$(id -u) <that path>.
     Fires every hour at :30, not once: a run in a sleeping Mac's dark wake can fail, so the script
     no-ops before 04:30 local (after the 08:00-08:20 UTC trending crons) and once today has a good
     backup, and otherwise retries each hour. A Mac asleep through several runs gets one on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kobalabs.pantry-db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/loganshaver/pantry/scripts/backup-db.sh &gt;&gt; "$HOME/Backups/pantry-db/backup.log" 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
</dict>
</plist>
