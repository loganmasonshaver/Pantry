# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*
.env*.local
.env.save

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Pantry-scan eval test photos (local only)
scripts/pantry-eval/images/*
!scripts/pantry-eval/images/.gitkeep

# Third-party agent skills installed via `npx skills add`.
# superwall-editor reads a Superwall API key from its own .env — never let that
# reach the repo. Only the vendor symlinks are ignored; our own .claude/skills/* stay tracked.
.agents/
.claude/skills/superwall
.claude/skills/superwall-editor
.claude/skills/wwdc
.claude/worktrees/


# Supabase CLI local cache — regenerated by the CLI, rewrites itself on every call
supabase/.temp/

# Deno lockfile — a byproduct of ad-hoc `deno check` runs on the edge functions.
# Ignored rather than committed because nothing consumes it: there is no deno.json in
# the repo, no script runs deno, and `supabase functions deploy` uploads only the .ts
# sources (verified in the deploy output) and resolves imports at deploy time. Tracking
# it would mean diff noise on a file with no reader.
# If reproducible edge-function builds are ever wanted, the real setup is a deno.json +
# a committed lock + `deno check --frozen` in CI — at which point remove this line.
deno.lock
